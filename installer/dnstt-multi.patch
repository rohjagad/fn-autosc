+// nameBasedPrefix returns the fixed RDATA fields that precede the target name
+// for MX and SRV. CNAME and NS have no prefix.
+func nameBasedPrefix(qtype uint16) []byte {
+	switch qtype {
+	case dns.RRTypeMX:
+		return []byte{0, 0}
+	case dns.RRTypeSRV:
+		return []byte{0, 0, 0, 0, 0, 0}
+	}
+	return nil
+}
+
+func isNameBasedRecordType(qtype uint16) bool {
+	switch qtype {
+	case dns.RRTypeCNAME, dns.RRTypeNS, dns.RRTypeMX, dns.RRTypeSRV:
+		return true
+	}
+	return false
+}
+
+// encodePayloadAsName encodes downstream data as a DNS name. The payload is
+// base32-encoded into 63-octet labels, with no tunnel-domain suffix. This is
+// the format HTTP Custom's slowdns client expects for CNAME/NS/MX/SRV answers;
+// its dns.decodeCNAMEPayload base32-decodes every label in the RDATA name. An
+// empty payload is the root name.
+func encodePayloadAsName(payload []byte, qtype uint16) ([]byte, error) {
+	prefix := nameBasedPrefix(qtype)
+	var buf bytes.Buffer
+	buf.Write(prefix)
+	if len(payload) == 0 {
+		buf.WriteByte(0)
+		return buf.Bytes(), nil
+	}
+
+	encoded := make([]byte, base32Encoding.EncodedLen(len(payload)))
+	base32Encoding.Encode(encoded, payload)
+	encoded = bytes.ToLower(encoded)
+
+	total := 1 // terminating zero label
+	for len(encoded) > 63 {
+		if total+1+63 > 255 {
+			return nil, fmt.Errorf("encoded payload does not fit in a DNS name")
+		}
+		buf.WriteByte(63)
+		buf.Write(encoded[:63])
+		encoded = encoded[63:]
+		total += 1 + 63
+	}
+	if len(encoded) > 0 {
+		if total+1+len(encoded) > 255 {
+			return nil, fmt.Errorf("encoded payload does not fit in a DNS name")
+		}
+		buf.WriteByte(byte(len(encoded)))
+		buf.Write(encoded)
+		total += 1 + len(encoded)
+	}
+	buf.WriteByte(0)
+	return buf.Bytes(), nil
+}
+
+// computeMaxEncodedPayloadNameBased returns the largest raw payload that fits
+// in a CNAME/NS/MX/SRV RDATA name. MX/SRV fixed fields are outside the name,
+// so all four types share the same capacity.
+func computeMaxEncodedPayloadNameBased() int {
+	// A name is at most 255 octets: label length bytes, label data, and
+	// the terminating zero label. Four labels of at most 63 octets leave
+	// room for 250 base32 characters. Base32 lengths are multiples of 8,
+	// so 248 characters (31 groups) is the largest usable length, which
+	// decodes to 155 bytes.
+	const maxEncoded = 248
+	return maxEncoded * 5 / 8
+}
+
+// maxEncodedPayloadForType returns the downstream payload budget for a query
+// type.  Name-based records have a smaller capacity than TXT/NULL, so sessions
+// using them need a smaller KCP MTU.
+func maxEncodedPayloadForType(qtype uint16, maxEncodedPayload int) int {
+	if isNameBasedRecordType(qtype) {
+		if nameCap := computeMaxEncodedPayloadNameBased(); nameCap < maxEncodedPayload {
+			return nameCap
+		}
+	}
+	return maxEncodedPayload
+}
