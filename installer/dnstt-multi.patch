+// clientRecordTypes remembers the QTYPE each client used.  The QTYPE is
+// needed when a KCP session is accepted to choose an MTU that fits in a
+// name-based answer (CNAME/NS/MX/SRV), while keeping the larger MTU for
+// TXT/NULL clients.
+type clientRecordTypes struct {
+	cache *ttlcache.Cache[turbotunnel.ClientID, uint16]
+}
+
+func newClientRecordTypes() *clientRecordTypes {
+	cache := ttlcache.New(
+		ttlcache.WithTTL[turbotunnel.ClientID, uint16](10 * time.Minute),
+	)
+	go cache.Start()
+	return &clientRecordTypes{cache: cache}
+}
+
+func (c *clientRecordTypes) set(id turbotunnel.ClientID, qtype uint16) {
+	c.cache.Set(id, qtype, ttlcache.DefaultTTL)
+}
+
+func (c *clientRecordTypes) get(id turbotunnel.ClientID) (uint16, bool) {
+	item := c.cache.Get(id)
+	if item == nil {
+		return 0, false
+	}
+	return item.Value(), true
+}
